              "description": "CPU and Memory are runtime limits. ResourceAware Sandboxes may override\nthem per request; otherwise they are the defaults.",
              "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
              "x-kubernetes-int-or-string": true
            },
            "memory": {
              "anyOf": [
