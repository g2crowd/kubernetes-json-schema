              "endpoint": {
                "description": "InfraEndpoint is the single public endpoint of a component.",
                "properties": {
                  "port": {
                    "format": "int32",
                    "maximum": 65535,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "protocol": {
                    "enum": [
                      "HTTP"
