            "bufferMax": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "bufferMin": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "poolMax": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "poolMin": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "bufferMax",
            "bufferMin",
            "poolMax",
            "poolMin"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "fastletTemplate": {
          "description": "FastletTemplate is intentionally preserved as a Kubernetes-native pod\ntemplate. Fast Sandbox validates the platform-owned fields separately.",
          "x-kubernetes-preserve-unknown-fields": true
        },
        "infraComponents": {
          "description": "InfraComponents are compiled into an immutable revision. Updating this\nlist rolls Fastlets; existing Sandboxes remain on their admitted revision.",
          "items": {
            "description": "InfraComponent injects one artifact-backed managed process with one public\nnamed endpoint. host-process components are declared for revision,\nFastlet-side readiness probing, and routing purposes only: they carry no\nartifact and are deployed by fastletTemplate in the Pod network namespace.",
            "properties": {
              "artifact": {
                "description": "Artifact is required unless delivery selects host-process.",
                "properties": {
                  "mappings": {
                    "items": {
                      "description": "InfraArtifactMapping maps one final file or directory from the verified\nartifact root to one final path in the Sandbox.",
                      "properties": {
                        "sourcePath": {
                          "pattern": "^/",
                          "type": "string"
                        },
                        "targetPath": {
                          "pattern": "^/\\.fast/components/",
                          "type": "string"
                        }
                      },
                      "required": [
                        "sourcePath",
                        "targetPath"
                      ],
                      "type": "object",
                      "additionalProperties": false
                    },
                    "maxItems": 64,
                    "minItems": 1,
                    "type": "array"
                  },
                  "source": {
                    "description": "InfraArtifactSource contains exactly one immutable source.",
                    "properties": {
                      "archive": {
                        "description": "InfraArtifactArchive selects one immutable gzip-compressed tar archive.",
                        "properties": {
                          "sha256": {
                            "pattern": "^[a-f0-9]{64}$",
                            "type": "string"
                          },
                          "url": {
                            "pattern": "^https://",
                            "type": "string"
                          }
                        },
                        "required": [
                          "sha256",
                          "url"
                        ],
                        "type": "object",
                        "additionalProperties": false
                      },
                      "image": {
                        "description": "InfraArtifactImage selects an immutable OCI image or index as an artifact\ncarrier. Fast Sandbox injects mapped files and never starts this image.",
                        "properties": {
                          "reference": {
                            "pattern": "^.+@sha256:[a-f0-9]{64}$",
                            "type": "string"
                          }
                        },
                        "required": [
                          "reference"
                        ],
                        "type": "object",
                        "additionalProperties": false
                      }
                    },
                    "type": "object",
                    "additionalProperties": false
                  }
                },
                "required": [
                  "mappings",
                  "source"
                ],
                "type": "object",
                "additionalProperties": false
              },
              "delivery": {
                "description": "InfraDeliveryMode selects an explicit delivery path for one Infra Component.\nAn empty value selects the runtime-defaulted delivery mode. host-process is\nthe only explicitly selectable mode today.",
                "enum": [
                  "host-process"
                ],
                "type": "string"
