    "spec": {
      "description": "SandboxPoolSpec defines the desired state of SandboxPool.",
      "properties": {
        "actionHandlers": {
          "description": "ActionHandlers are Pod-local HTTP receivers used by ordered per-Sandbox\nAction Bindings.",
          "items": {
            "description": "ActionHandler declares one Pod-local HTTP receiver served on loopback.",
            "properties": {
              "hooks": {
                "description": "Hooks selects the lifecycle checkpoints delivered to this Handler. An\nempty list makes the Handler config-only: it receives SetBinding and\nRemoveBinding but no lifecycle Hook calls.",
                "items": {
                  "description": "LifecycleHook is a versioned Fastlet-local Sandbox lifecycle checkpoint.\nIt is intentionally a string alias so future hooks do not require changing\nthe CRD shape. ValidateActionHandlers rejects names unsupported by this\nFastlet version instead of silently ignoring them.",
                  "type": "string"
                },
                "maxItems": 16,
                "type": "array",
                "x-kubernetes-list-type": "set"
              },
              "name": {
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "type": "string"
              },
              "targetHTTPPort": {
                "format": "int32",
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "targetHTTPPort"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "maxItems": 16,
          "type": "array",
          "x-kubernetes-list-map-keys": [
            "name"
