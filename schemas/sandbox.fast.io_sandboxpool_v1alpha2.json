                "type": "object",
                "additionalProperties": false
              },
              "name": {
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "type": "string"
              },
              "process": {
                "description": "InfraProcess defines the process supervised inside the user Sandbox.",
                "properties": {
                  "command": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "env": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "healthCheck": {
                    "description": "InfraHealthCheck contains exactly one probe kind.",
                    "properties": {
                      "httpGet": {
                        "description": "InfraHTTPGet is an HTTP readiness probe on the component endpoint.",
                        "properties": {
                          "path": {
                            "pattern": "^/",
                            "type": "string"
                          }
                        },
                        "required": [
                          "path"
                        ],
                        "type": "object",
                        "additionalProperties": false
                      },
                      "tcpConnect": {
                        "description": "InfraTCPConnect selects a TCP connect readiness probe.",
                        "type": "object"
                      },
                      "timeoutSeconds": {
                        "default": 10,
                        "format": "int32",
                        "maximum": 300,
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "type": "object",
                    "additionalProperties": false
                  },
                  "restartPolicy": {
                    "default": "OnFailure",
                    "description": "InfraRestartPolicy controls process restart after exit.",
                    "enum": [
                      "Never",
                      "OnFailure",
                      "Always"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "command",
                  "healthCheck"
